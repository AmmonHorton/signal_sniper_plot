"""Top-level Bazel build targets for signal_sniper_plot."""

load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@pybind11_bazel//:build_defs.bzl", "pybind_extension")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("@rules_python//python:pip.bzl", "compile_pip_requirements")

# C++17 is required across all targets.
# Alternatively, set globally in .bazelrc with: build --cxxopt=-std=c++17
_COPTS = ["-std=c++17"]

# ── C++ library targets ───────────────────────────────────────────────────────

# Low-level sample/trace types and raw-buffer conversion utilities.
cc_library(
    name = "trace_utils",
    srcs = ["src/trace_utils.cc"],
    hdrs = ["inc/trace_utils.h"],
    copts = _COPTS,
    strip_include_prefix = "inc",
    visibility = ["//visibility:public"],
)

# X11 interactive plot session: rendering, event loop, zoom/pan, streaming.
cc_library(
    name = "plot_session",
    srcs = ["src/plot_session.cc"],
    hdrs = ["inc/plot_session.h"],
    copts = _COPTS,
    strip_include_prefix = "inc",
    deps = [
        ":trace_utils",
        "@system_libs//:x11",
    ],
    visibility = ["//visibility:public"],
)

# Public C++ API: thin wrappers over PlotSession.
cc_library(
    name = "signal_sniper_plot",
    srcs = ["src/plot.cc"],
    hdrs = ["inc/plot.h"],
    copts = _COPTS,
    strip_include_prefix = "inc",
    deps = [
        ":plot_session",
        ":trace_utils",
    ],
    visibility = ["//visibility:public"],
)

# ── ssp: new implementation (see docs/ARCHITECTURE_PROPOSAL.md) ──────────────
# ssp_core has no X11 dependency: it builds, renders and runs the whole interactive loop
# (against a fake backend) without a display. ssp adds the X11 window.

cc_library(
    name = "ssp_core",
    srcs = [
        "src/api/save_png.cc",
        "src/app/compose.cc",
        "src/app/controller.cc",
        "src/app/cut.cc",
        "src/app/job_runner.cc",
        "src/app/menu.cc",
        "src/app/overlay.cc",
        "src/app/raster_content.cc",
        "src/app/screen.cc",
        "src/app/session.cc",
        "src/app/trace_content.cc",
        "src/app/trace_content_ir.cc",
        "src/core/lod.cc",
        "src/render/axis.cc",
        "src/render/colormap.cc",
        "src/render/frame.cc",
        "src/render/framebuffer.cc",
        "src/render/png.cc",
        "src/render/trace.cc",
    ],
    hdrs = [
        "inc/ssp/plot.h",
        "inc/ssp/types.h",
        "src/app/compose.h",
        "src/app/content.h",
        "src/app/controller.h",
        "src/app/cut.h",
        "src/app/job_runner.h",
        "src/app/menu.h",
        "src/app/overlay.h",
        "src/app/raster_content.h",
        "src/app/screen.h",
        "src/app/session.h",
        "src/app/settings.h",
        "src/app/trace_content.h",
        "src/core/cancel.h",
        "src/core/component.h",
        "src/core/dispatch.h",
        "src/core/lod.h",
        "src/core/scan.h",
        "src/platform/backend.h",
        "src/render/axis.h",
        "src/render/colormap.h",
        "src/render/frame.h",
        "src/render/framebuffer.h",
        "src/render/png.h",
        "src/render/trace.h",
    ],
    textual_hdrs = [
        "src/render/colormaps.inc",
        "src/render/font_6x13.inc",
    ],
    copts = _COPTS,
    includes = ["inc", "src"],
    linkopts = ["-lpthread"],
    deps = ["@zlib"],
    visibility = ["//visibility:public"],
)

# The installed C++ API (packaging/ ships these).
filegroup(
    name = "ssp_public_headers",
    srcs = [
        "inc/ssp/plot.h",
        "inc/ssp/types.h",
    ],
    visibility = ["//packaging:__pkg__"],
)

# Public C++ library: ssp::plot / ssp::Session (X11 window) and ssp::save_png.
cc_library(
    name = "ssp",
    srcs = [
        "src/api/plot.cc",
        "src/platform/x11_backend.cc",
    ],
    copts = _COPTS,
    deps = [
        ":ssp_core",
        "@system_libs//:x11",
    ],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "ssp_core_test",
    srcs = [
        "tests/ssp/axis_test.cc",
        "tests/ssp/controller_test.cc",
        "tests/ssp/framebuffer_test.cc",
        "tests/ssp/lod_test.cc",
        "tests/ssp/raster_test.cc",
        "tests/ssp/session_test.cc",
        "tests/ssp/trace_test.cc",
    ],
    copts = _COPTS,
    deps = [
        ":ssp_core",
        "@googletest//:gtest_main",
    ],
)

# Needs an X display; skips without one:  DISPLAY=:99 bazel test //:ssp_x11_test --test_env=DISPLAY
cc_test(
    name = "ssp_x11_test",
    srcs = ["tests/ssp/x11_backend_test.cc"],
    copts = _COPTS,
    tags = ["manual"],
    deps = [
        ":ssp",
        "@googletest//:gtest_main",
        "@system_libs//:x11",
    ],
)

cc_binary(
    name = "ssp_bench",
    srcs = ["tools/ssp_bench.cc"],
    copts = _COPTS,
    deps = [":ssp_core"],
)

# Interactive raster demo (needs a display):  bazel run -c opt //:ssp_raster_demo
cc_binary(
    name = "ssp_raster_demo",
    srcs = ["tools/ssp_raster_demo.cc"],
    copts = _COPTS,
    deps = [":ssp"],
)

# Interactive demo (needs a display):  bazel run -c opt //:ssp_demo -- [samples]
cc_binary(
    name = "ssp_demo",
    srcs = ["tools/ssp_demo.cc"],
    copts = _COPTS,
    deps = [":ssp"],
)

# Golden-image tests. On mismatch the actual image lands in bazel-testlogs/.../outputs.
# To accept new images:  SSP_UPDATE_GOLDENS=1 bazel run //:ssp_golden_test
cc_test(
    name = "ssp_golden_test",
    srcs = ["tests/ssp/golden_test.cc"],
    copts = _COPTS,
    data = glob(["tests/golden/*.png"], allow_empty = True),
    deps = [
        ":ssp_core",
        "@googletest//:gtest_main",
    ],
)

# ── Unit tests ────────────────────────────────────────────────────────────────
# Note: this test opens an X11 window; requires a live display (set DISPLAY).

cc_test(
    name = "test_signal_sniper_plot",
    srcs = ["tests/test_plot.cc"],
    copts = _COPTS,
    deps = [
        ":signal_sniper_plot",
        "@googletest//:gtest_main",
    ],
)

# ── Python extension ──────────────────────────────────────────────────────────

# Native Python extension module (.so) built with pybind11.
pybind_extension(
    name = "signal_sniper_plot_py",
    srcs = ["pybind_src/module.cc"],
    copts = _COPTS,
    deps = [":ssp"],
    visibility = ["//visibility:public"],
)

# ── Pip dependency management ─────────────────────────────────────────────────
# Regenerate requirements_lock.txt from requirements.in:
#   bazel run //:requirements.update

compile_pip_requirements(
    name = "requirements",
    src = "bazel/python_deps/requirements.in",
    requirements_txt = "bazel/python_deps/requirements_lock.txt",
    python_version = "3.12",
)

# ── Python scripts ────────────────────────────────────────────────────────────

# Quick manual demo: bazel run //:test_plot_py
py_binary(
    name = "test_plot_py",
    srcs = ["python/test_plot.py"],
    main = "python/test_plot.py",
    deps = [
        ":signal_sniper_plot_py",
        "@pip_deps//numpy",
    ],
)

# Headless tests of the Python bindings.
py_test(
    name = "ssp_py_test",
    srcs = ["python/test_ssp.py"],
    main = "python/test_ssp.py",
    deps = [
        ":signal_sniper_plot_py",
        "@pip_deps//numpy",
    ],
)

# OFDM acquisition/tracking demo:  bazel run //:ofdm_demo   (or -- --png DIR to save figures)
py_binary(
    name = "ofdm_demo",
    srcs = ["python/ofdm_demo.py"],
    main = "python/ofdm_demo.py",
    deps = [
        ":signal_sniper_plot_py",
        "@pip_deps//numpy",
    ],
)
