"""Python examples:
    bazel run //examples/python:basic   short plot / plot_buffer examples (needs a display)
    bazel run //examples/python:ofdm    OFDM acquisition and tracking; -- --png DIR saves figures
"""

load("@rules_python//python:defs.bzl", "py_binary")

py_binary(
    name = "basic",
    srcs = ["basic.py"],
    deps = [
        "//python:lib",
        "@pip_deps//numpy",
    ],
)

py_binary(
    name = "ofdm",
    srcs = ["ofdm.py"],
    deps = [
        "//python:lib",
        "@pip_deps//numpy",
    ],
)
